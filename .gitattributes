# Line endings are explicitly defined to prevent Git configuration variations
# (e.g., core.autocrlf=true) from causing execution or parsing errors.

* text=auto

# Enforces LF line endings for the shell script to ensure the shebang 
# (!/bin/sh) is correctly interpreted in Bash environments without \r characters.
bin/reaper-bridge text eol=lf

# Enforces CRLF line endings for batch files. LF-only endings can cause cmd.exe 
# to misinterpret labels and goto statements, leading to execution failures.
*.bat text eol=crlf
*.cmd text eol=crlf

# Enforces CRLF line endings for PowerShell scripts to align with Windows defaults
# and maintain uniform diffs across contributors.
*.ps1 text eol=crlf

*.py   text eol=lf
*.lua  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt  text eol=lf

# Binary files are excluded from line ending normalization to prevent data corruption.
*.png  binary
*.jpg  binary
*.wav  binary
*.flac binary
*.rpp  binary
