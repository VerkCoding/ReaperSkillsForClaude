{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "reaper-skills-for-claude",
  "description": "Claude works inside REAPER as an audio engineer: mixing, mastering, MIDI, FX, rendering, and real DSP measurement.",
  "version": "1.0.0",
  "author": {
    "name": "Mark",
    "url": "https://github.com/VerkCoding"
  },
  "homepage": "https://github.com/VerkCoding/ReaperSkillsForClaude",
  "repository": "https://github.com/VerkCoding/ReaperSkillsForClaude",
  "license": "MIT",
  "keywords": [
    "reaper",
    "daw",
    "audio",
    "mixing",
    "mastering",
    "midi",
    "music-production",
    "dsp"
  ],
  "skills": [
    "./",
    "./skills/reaper-audio-engineer",
    "./skills/reaper-core-setup",
    "./skills/reaper-mcp"
  ],
  "mcpServers": {
    "reaper": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/launch_server.py"],
      "env": {
        "REAPER_MCP_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
