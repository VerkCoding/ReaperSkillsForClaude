*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Claude / editor
*.bak
.vscode/
.idea/

# Claude Code writes machine-specific state here, and rewrites settings.json
# itself when plugin or marketplace commands run - so nothing in it is safe to
# ship. Install routes are documented in README.md instead.
.claude/

# Installer downloads, kept so a re-run does not fetch 300 MB again.
# Hundreds of megabytes of vendor binaries - never ours to commit, and the
# whole point is that it is machine-local. install\lib-cache.ps1 owns it.
downloadCache/

