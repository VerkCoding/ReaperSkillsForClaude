#!/bin/sh
# Wrapper for the REAPER file bridge.
#
# The bin/ directory is present on the PATH. This allows `reaper-bridge` to be 
# invoked without specifying an absolute path.
#
# Usage examples:
#   reaper-bridge --code 'return reaper.GetAppVersion()'
#   echo 'return 1+1' | reaper-bridge
#
# The location is resolved relative to the script path to avoid dependency on 
# the CLAUDE_PLUGIN_ROOT environment variable, which may not be present in all 
# contexts.
set -eu

self=$0

# Resolving symlinks ensures the relative path to the target script remains valid.
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done

root=$(cd "$(dirname "$self")/.." && pwd)
script=$root/scripts/bridge.py

[ -f "$script" ] || {
    echo "Error: $script not found." >&2
    exit 1
}

for py in "${REAPER_MCP_PYTHON:-}" python3 python py; do
    [ -n "$py" ] || continue
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$script" "$@"
    fi
done

echo "Error: Python interpreter not found." >&2
exit 1
