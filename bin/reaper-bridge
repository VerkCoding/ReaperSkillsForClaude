#!/bin/sh
# Wrapper for the REAPER file bridge.
#
# The bin/ directory is present on the PATH. This allows `reaper-bridge` to be 
# invoked without specifying an absolute path.
#
# Usage examples:
#   reaper-bridge --code 'return reaper.GetAppVersion()'
#   echo 'return 1+1' | reaper-bridge
#
# The location is resolved relative to the script path to avoid dependency on 
# the CLAUDE_PLUGIN_ROOT environment variable, which may not be present in all 
# contexts.
set -eu

self=$0

# Resolving symlinks ensures the relative path to the target script remains valid.
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done

root=$(cd "$(dirname "$self")/.." && pwd)
script=$root/scripts/bridge.py

[ -f "$script" ] || {
    echo "Error: $script not found." >&2
    exit 1
}

# The plugin virtual environment is preferred, matching scripts/launch_server.py.
#
# Each candidate is run before it is used. On Windows, python3 resolves to the
# Microsoft Store App Execution Alias, which exists on PATH and satisfies
# command -v, then refuses to run and exits 49 with "Python was not found".
# Selecting an interpreter on presence alone made the wrapper unusable there
# unless REAPER_MCP_PYTHON was set by hand.
for py in \
    "${REAPER_MCP_PYTHON:-}" \
    "$HOME/.reaper-for-claude/venv/Scripts/python.exe" \
    "$HOME/.reaper-for-claude/venv/bin/python" \
    python3 python py
do
    [ -n "$py" ] || continue
    command -v "$py" >/dev/null 2>&1 || continue
    "$py" -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3, 7) else 1)' >/dev/null 2>&1 || continue
    exec "$py" "$script" "$@"
done

echo "Error: Python interpreter not found." >&2
exit 1
